# Podman Quadlet unit. Copy to ~/.config/containers/systemd/ and run
# `systemctl --user daemon-reload && systemctl --user enable --now oura-hub.service`.
# Replace 100.112.25.101 with `tailscale ip -4`, or drop that line for loopback only.
[Unit]
Description=Open Oura health hub
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/oura-hub:latest
ContainerName=oura-hub
PublishPort=127.0.0.1:8787:8787
PublishPort=100.112.25.101:8787:8787
Environment=RUST_LOG=info
# OURA_HUB_TOKEN=<token>
EnvironmentFile=%h/.config/oura-hub.env
Volume=%h/oura-hub-data:/data:Z

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
