# Podman Quadlet unit for the hub. deploy/install.sh copies it to
# ~/.config/containers/systemd/ and adds the PublishPort lines for this machine
# (loopback and the Tailscale address). Run install.sh instead of copying it by hand.
[Unit]
Description=Open Oura health hub
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/oura-hub:latest
ContainerName=oura-hub
Environment=RUST_LOG=info
# OURA_HUB_TOKEN=<token>
EnvironmentFile=%h/.config/oura-hub.env
Volume=%h/oura-hub-data:/data:Z
# the agent CLIs' logins
Volume=%h/oura-hub-agent/claude:/root/.claude:Z
Volume=%h/oura-hub-agent/codex:/root/.codex:Z
Volume=%h/oura-hub-agent/cursor:/root/.cursor:Z
Volume=%h/oura-hub-agent/config:/root/.config:Z

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
